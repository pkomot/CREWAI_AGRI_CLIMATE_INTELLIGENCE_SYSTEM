# --- LLM (pick one; none set = offline deterministic engine) -----------------
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AGRI_CREW_LLM_MODEL=anthropic/claude-sonnet-5-5        # or "offline"
# AGRI_CREW_MANAGER_LLM_MODEL=anthropic/claude-opus-5-5

# --- Memory embedder (Anthropic has no embeddings API) ------------------------
# Auto-selected from GEMINI_API_KEY / OPENAI_API_KEY / VOYAGE_API_KEY, or set explicitly:
# AGRI_CREW_EMBEDDER={"provider":"voyageai","config":{"api_key":"...","model":"voyage-3.5"}}
# AGRI_CREW_MEMORY=true
# AGRI_CREW_STORAGE_DIR=.agri_crew

# --- Data sources ---------------------------------------------------------------
AGRI_CREW_MODE=mock                        # mock | live
# AGRI_CREW_KAMIS_BASE_URL=https://your-adapter.example/kamis
# AGRI_CREW_KMD_BASE_URL=https://your-adapter.example/kmd
# AGRI_CREW_KALRO_BASE_URL=https://your-adapter.example/kalro
# AGRI_CREW_API_BEARER_TOKEN=

# --- Guardrails -------------------------------------------------------------------
# AGRI_CREW_MAX_ITER=15
# AGRI_CREW_MAX_RPM=30
# AGRI_CREW_TOOL_TIMEOUT_S=8
# AGRI_CREW_RETRY_MAX_ATTEMPTS=3

# --- Optional -------------------------------------------------------------------
# SERPER_API_KEY=                          # web search for the climate analyst
# AGRI_CREW_MCP_SERVERS=[{"type":"http","url":"https://kb.example/mcp","headers":{"Authorization":"Bearer ${KB_TOKEN}"},"agents":["kalro_specialist"]}]
# AGRI_CREW_VERBOSE=true
